---
import { getEntry } from "astro:content";
import Logo from "./Logo.astro";
import { navItems, byOrder } from "../lib/navigation";

const site = (await getEntry("settings", "site"))!.data;
const { address } = site;

// Through the shared helper, so a page that is only a link to another website
// is listed as that link rather than as a route that was never built.
const pages = (await navItems()).filter((i) => i.navGroup !== "none").sort(byOrder);

---

<footer class="site-footer on-ink">
  <div class="wrap footer-grid">
    <div class="footer-logo">
      <Logo variant="lockup" width={120} />
    </div>

    <div>
      <h2 class="eyebrow">Visit us</h2>
      <address>
        {address.street}<br />
        {address.city}, {address.state} {address.zip}
      </address>
      {site.officeHours && <p class="hours">{site.officeHours}</p>}
    </div>

    <div>
      <h2 class="eyebrow">Get in touch</h2>
      <ul class="plain">
        {site.phone && <li><a href={`tel:${site.phone.replace(/[^0-9+]/g, "")}`}>{site.phone}</a></li>}
        {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        {site.facebookUrl && <li><a href={site.facebookUrl} rel="noopener">Facebook</a></li>}
      </ul>
    </div>

    <div>
      <h2 class="eyebrow">Pages</h2>
      <ul class="plain">
        {
          pages.map((p) => (
            <li>
              <a href={p.href} {...(p.newTab ? { target: "_blank", rel: "noopener" } : {})}>
                {p.label}
              </a>
            </li>
          ))
        }
        <li><a href="/news/">News</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-base">
    <p>{site.schoolName}. Founded 1990.</p>
    <p><a href="/admin/">Staff login</a></p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-md);
    margin-top: var(--space-xl);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 34em) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60em) {
    .footer-grid {
      grid-template-columns: auto repeat(3, 1fr);
      gap: var(--space-lg);
    }
  }

  /* Colour the wrapper, not the component. Scoped styles key off the
     defining component's id, so a class passed to a child never matches. */
  .footer-logo {
    color: var(--paper);
    opacity: 0.92;
  }

  address {
    font-style: normal;
  }

  .hours {
    color: var(--text-on-ink-muted);
    margin-top: var(--space-xs);
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .plain li {
    margin-bottom: var(--space-2xs);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: var(--border-on-ink);
    color: var(--text-on-ink-muted);
    font-size: var(--step--1);
  }

  .footer-base p {
    margin: 0;
  }
</style>
