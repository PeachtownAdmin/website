---
import Icon from "./Icon.astro";
import type { CollectionEntry } from "astro:content";

// A single line showing the newest announcement, directly under the hero, so
// the site reads as maintained rather than static. Renders nothing when there
// is no published news, which on past posting history is a real possibility.

interface Props {
  post?: CollectionEntry<"news">;
}

const { post } = Astro.props;
---

{
  post && (
    <aside class="latest">
      <a class="wrap latest-inner" href={`/news/${post.id}/`}>
        <Icon name="megaphone" size={20} />
        <span class="latest-tag">Latest</span>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric" })}
        </time>
        <span class="latest-title">{post.data.title}</span>
        <span class="latest-go">
          <Icon name="arrow" size={18} />
        </span>
      </a>
    </aside>
  )
}

<style>
  .latest {
    background: var(--ink-soft);
    color: var(--text-on-ink);
  }

  .latest-inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.7rem;
    text-decoration: none;
    color: inherit;
  }

  .latest-tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber-light);
    flex: none;
  }

  time {
    font-size: var(--step--1);
    color: var(--text-on-ink-muted);
    flex: none;
  }

  .latest-title {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--amber) 70%, transparent);
    text-underline-offset: 0.22em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-go {
    margin-left: auto;
    display: inline-flex;
    flex: none;
  }

  .latest-inner:hover .latest-title {
    text-decoration-color: var(--amber);
  }

  /* The date is the first thing to go when space runs out. */
  @media (max-width: 34em) {
    time {
      display: none;
    }
  }
</style>
