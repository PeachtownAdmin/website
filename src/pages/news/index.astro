---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("news", (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="News" description="News and announcements from Peachtown Elementary School.">
  <h1>News</h1>

  {posts.length === 0 && <p>There are no published announcements yet.</p>}

  <ul class="news-list">
    {
      posts.map((post) => (
        <li>
          <h2><a href={`/news/${post.id}/`}>{post.data.title}</a></h2>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
          {post.data.summary && <p>{post.data.summary}</p>}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .news-list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .news-list li {
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .news-list h2 {
    font-size: var(--step-2);
    margin-bottom: 0;
  }

  time {
    color: var(--color-text-muted);
    font-size: 0.9em;
  }
</style>
