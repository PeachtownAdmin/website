---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

// The school already keeps its calendar in Google Calendar. Embedding it means
// staff carry on using the tool they know, rather than maintaining dates twice.

const site = (await getEntry("settings", "site"))!.data;
const page = await getEntry("pages", "calendar");
const { Content } = page ? await render(page) : { Content: null };

const calendarId = site.googleCalendarId ?? "";
const src = calendarId
  ? `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(
      calendarId
    )}&ctz=America%2FNew_York&mode=MONTH&showTitle=0&showPrint=0&showTabs=1&showCalendars=0&bgcolor=%23F5F1E6`
  : "";
---

<BaseLayout title="Calendar" description="Term dates, events and performances at Peachtown.">
  <PageHeader
    title="Calendar"
    description="Term dates, events and performances. Scroll inside the calendar to move between months."
  />

  <div class="wrap page-body">
    {
      src ? (
        <div class="calendar-frame">
          <iframe src={src} title="Peachtown school calendar" loading="lazy" />
        </div>
      ) : (
        <p class="prose">The school calendar has not been set up yet.</p>
      )
    }

    {
      Content && (
        <div class="prose calendar-note">
          <Content />
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-body {
    padding-block: var(--space-lg);
  }

  /* The embed has a fixed aspect on desktop and a taller one on phones, where
     a month grid squeezed into 16:9 is unreadable. */
  .calendar-frame {
    background: var(--paper-dim);
    border: var(--border);
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 48em) {
    .calendar-frame {
      aspect-ratio: 16 / 10;
    }
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .calendar-note {
    margin-top: var(--space-md);
  }
</style>
